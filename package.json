{
  "name": "mercadia",
  "private": true,
  "version": "0.1.0",
  "description": "Multi-vendor marketplace built with microservices",
  "type": "module",
  "workspaces": [
    "packages/*",
    "services/*",
    "apps/*"
  ],
  "scripts": {
    "build:packages": "npm run build -w @mercadia/contracts -w @mercadia/service-kit",
    "build": "npm run build:packages && npm run build --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "format": "prettier --write \"**/*.{ts,tsx}\" --ignore-path .gitignore",
    "format:check": "prettier --check \"**/*.{ts,tsx}\" --ignore-path .gitignore",
    "infra:up": "docker compose -f docker-compose.infra.yml up -d --wait",
    "infra:down": "docker compose -f docker-compose.infra.yml down"
  },
  "engines": {
    "node": ">=22"
  }
}
