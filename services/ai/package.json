{
  "name": "@mercadia/ai",
  "version": "0.1.0",
  "private": true,
  "description": "Python service; npm scripts only wire it into the monorepo commands.",
  "scripts": {
    "dev": ".venv/bin/uvicorn app.main:app --reload --port 8000",
    "start": ".venv/bin/uvicorn app.main:app --host 0.0.0.0 --port ${PORT:-8000}",
    "setup": "python3 -m venv .venv && .venv/bin/pip install -q -r requirements.txt -r requirements-dev.txt"
  }
}
